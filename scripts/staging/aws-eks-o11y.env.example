# Non-secret environment contract for scripts/staging/validate-aws-eks-o11y.sh.
# Copy values into your shell or CI environment. The runner does NOT source
# this file. Never place token contents here; only provide a token-file path.

export STAGING_EXPECTED_AWS_ACCOUNT_ID="123456789012"
export AWS_REGION="us-east-1"
export STAGING_EKS_CLUSTER_NAME="observability-staging"
export STAGING_KUBE_CONTEXT="arn:aws:eks:us-east-1:123456789012:cluster/observability-staging"
export STAGING_NAMESPACE="staging"
export STAGING_WORKLOAD="Deployment/checkout-api"
export STAGING_APM_SERVICE="checkout-api"
export COLLECTOR_NAMESPACE="splunk-otel"
export COLLECTOR_RELEASE="splunk-otel-collector"
export INSTRUMENTATION_NAME="splunk-otel-staging"
export WORKLOAD_LANGUAGE="java"

# Short-lived administrator User API session token; mode 0600, single hard link.
# One writer-added trailing LF or CRLF is accepted; other whitespace is not.
export SPLUNK_O11Y_REALM="us1"
export SPLUNK_O11Y_TOKEN_FILE="/secure/splunk_o11y_token"

export STAGING_OTEL_RENDERED_DIR="$PWD/splunk-observability-otel-rendered"
export STAGING_AUTO_INSTRUMENTATION_RENDERED_DIR="$PWD/splunk-observability-k8s-auto-instrumentation-rendered"
export STAGING_AWS_INTEGRATION_RENDERED_DIR="$PWD/splunk-observability-aws-integration-rendered"

# Optional validators. Leave unset to record an explicit skipped check.
# export STAGING_LAMBDA_APM_RENDERED_DIR="$PWD/splunk-observability-aws-lambda-apm-rendered"
# export STAGING_CLOUD_INTEGRATION_RENDERED_DIR="$PWD/splunk-observability-cloud-integration-rendered"

# Optional output override. --report PATH takes precedence.
export STAGING_REPORT_PATH="$PWD/aws-eks-o11y-staging-report.json"
