ic recovery fails.\n* Improves Collection Health troubleshooting for recovered, pending, failed, and unresolved authorization states.\n* Adds direct navigation to Home, Connections, Data Collection, Collection Health, and Search.\n* Displays the installed add-on version and build number on Home.\n* Updates runtime dependencies and strengthens release-package validation.\n\nAfter upgrading, replace the Activation Token only if automatic recovery fails and Cisco Spaces continues to reject the credentials.", "passed_validation": true, "path": "https://splunkbase.splunk.com/app/8485/release/2.0.11/download/", "platform": "independent", "product_compatibility": "splunk", "product_types": ["enterprise", "cloud"], "published_time": "2026-09-14T23:48:10.314300Z", "release_id": 124168, "release_name": "2.0.11", "sha256": "e49370d0291468224bd7f50c59a210d5ff3b5c449406a24d3a8bb43bd513765d", "size": 4085542, "spl_compatibility": "SPL1", "tags_sourcetypes": {"__no_tag__": ["cisco:spaces:log", "cisco:spaces:firehose:health", "cisco:spaces:firehose"]}, "version_compatibility": ["10.7", "10.6", "10.5", "10.4", "10.3", "10.2"]}, {"actions": [], "cim_compatibility": ["8.x", "6.x"], "cloud_compatible": true, "content": ["inputs"], "filename": "spaces-add-on-for-splunk_201.tar.gz", "fips_compatibility": false, "install_method_distributed": "appmgmt_phase", "install_method_single": "simple", "manifest": {"dependencies": null, "incompatibleApps": null, "info": {"author": [{"company": "Cisco", "email": "slight@cisco.com", "name": "Simon Light"}], "classification": {"categories": ["Security, Fraud & Compliance"], "developmentStatus": "Production/Stable", "intendedAudience": "IT Professionals"}, "commonInformationModels": null, "id": {"group": null, "name": "ta_cisco_spaces", "version": "2.0.1"}, "license": {"name": null, "text": "LICENSE.txt", "uri": null}, "privacyPolicy": {"name": null, "text": null, "uri": null}, "releaseDate": null, "releaseNotes": {"name": "README", "text": "README.txt