story", "meraki:cameras", "meraki:audit", "meraki:accesspoints"], "inventory": ["meraki:wirelesscontrolleravailabilitieschangehistory", "meraki:switchportsbyswitch", "meraki:powermodulesstatusesbydevice", "meraki:devicesuplinksaddressesbydevice", "meraki:devicesavailabilities", "meraki:devices"], "malware": ["meraki:organizationsecurity"], "network": ["meraki:wirelesscontrollerdevicesinterfacesusagehistorybyinterval", "meraki:wirelesscontrollerdevicesinterfacespacketsoverviewbydevice", "meraki:securityappliances"], "performance": ["meraki:wirelessdevicespacketlossbydevice"], "session": ["meraki:securityappliances"], "web": ["meraki:apirequestshistory"]}, "version_compatibility": ["10.7", "10.6", "10.5", "10.4", "10.3", "10.2"]}, {"actions": [], "cim_compatibility": ["8.x"], "cloud_compatible": true, "content": [], "filename": "cisco-meraki-add-on-for-splunk_340.tgz", "fips_compatibility": false, "install_method_distributed": "appmgmt_phase", "install_method_single": "simple", "manifest": {"dependencies": null, "incompatibleApps": null, "info": {"author": [{"company": null, "email": null, "name": "Splunk, Inc."}], "classification": {"categories": ["Security, Fraud & Compliance"], "developmentStatus": "Production/Stable", "intendedAudience": "IT Professionals"}, "commonInformationModels": {"Alerts": "==4.18.1", "Authentication": "==4.18.1", "Change": "==4.18.1", "Malware": "==4.18.1", "Network Session": "==4.18.1"}, "id": {"group": null, "name": "Splunk_TA_cisco_meraki", "version": "3.4.0"}, "license": {"name": null, "text": "LICENSES/LicenseRef-Splunk-8-2021.txt", "uri": null}, "privacyPolicy": {"name": null, "text": null, "uri": null}, "releaseDate": null, "releaseNotes": {"name": "README", "text": "README.txt", "uri": "https://docs.splunk.com/Documentation/AddOns/CiscoMeraki/About"}, "title": "Cisco Meraki Add-on for Splunk"}, "inputGroups": null, "platformRequirements": null, "schemaVersion": "2.0.0", "supportedDeployments": ["_standalone", "_distributed", "_search_head_clustering"], "targetWorkloads": ["_search_heads", "_indexers"], "tasks": null}, "md5": "4c671c823717f1670d4509eaa406314c", "min_product_version_str": null, "notes": "# Cisco Meraki Add-on for Splunk 3.4.0\n\n## Important compatibility notice\n\n- Version 3.4.0 requires Splunk Enterprise or Splunk Cloud Platform 10.2 or\n  later with Python 3.13. Do not configure or enable this version on an earlier\n  Splunk platform release.\n- Splunk Enterprise 9.4 does not provide the Python 3.13 runtime selected by\n  this add-on and is not supported by version 3.4.0.\n- On an unsupported Splunk platform release, the Inputs or Configuration page\n  can fail to load and display the following Python handler error:\n  `TypeError: unsupported operand type(s) for |: 'type' and 'type'`. This error\n  indicates an incompatible Python runtime, not a Meraki credential or input\n  configuration failure.\n- All modular inputs and Python REST handlers declare\n  `python.required = 3.13`.\n- The Home dashboard displays a compatibility warning when the current search\n  head runs an unsupported Splunk platform release.\n- Customers who must temporarily remain on an older Splunk platform release\n  can download version 3.3.0 from the Cisco Meraki Add-on for Splunk page on\n  Splunkbase. Version 3.3.0 does not contain fixes and features added in later\n  releases.\n\n## What's new\n\n- Standardizes all current Dashboard Studio charts on the shared Cisco C3\n  visualization palette. Informational, healthy, caution, critical, comparison,\n  and unknown states now retain the same color meaning across workspaces.\n- Uses outlined markers and connects null values on every Dashboard Studio line\n  chart so isolated samples and intermittent collection gaps remain readable.\n- Pins assurance-alert pie slices to label-based C3 severity colors so critical,\n  warning, informational, and unknown categories cannot change meaning when a\n  category is absent or the result order changes.\n- Adds a TA API health tab to Data Collection Health that measures only Meraki\n  Dashboard API calls attributed to this add-on. The panels use\n  `meraki:apirequestshistory` events whose User-Agent contains\n  `SplunkAddOnForCiscoMeraki`.\n- Adds request volume, success rate, rate-limit indicators, operation frequency,\n  response outcomes, OAuth client identity, failure details, and bounded\n  estimates of the Splunk platform license volume used by API request-history\n  events generated by the add-on.\n- Normalizes matching API request-history `userAgent` values to\n  `SplunkAddOnForCiscoMeraki` before indexing. User-Agent values for other API\n  clients remain unchanged, and the dashboard recognizes historical events\n  that contain the longer SDK-generated value.\n- Keeps the API Data dashboard as the organization-wide API exploration\n  workspace and links to it from Data Collection Health.\n- Adds an hourly Meraki ingest chart and a sourcetype table that combines event\n  counts, indexed volume, data freshness, expected collection interval, and\n  health status.\n\n## Fixed issues\n\n- Applies the complete Magic Eight index-time parsing contract to all 43\n  packaged `meraki:*` sourcetypes. The add-on now defines explicit JSON event\n  boundaries and timestamp scan limits, disables punctuation annotation and\n  automatic sourcetype learning, and preserves ingest time for snapshot data\n  that has no single event timestamp.\n- Replaces `dedup` commands before grouped dashboard aggregations with\n  `stats`-based reduction. History panels retain every transition, while\n  snapshot and repeatable API records are reduced by their logical identity\n  before distributions are calculated.\n- Removes redundant `spath` parsing and event-level `mvexpand` work from\n  structured Meraki JSON dashboard searches. Selective filters now run in\n  base searches, while response summaries aggregate extracted fields before\n  bounded presentation transforms.\n- Fixes Dashboard Studio rendering errors on the TA API health tab by using a\n  transforming base search with a single post-process level.\n- Fixes API health empty states so summary panels display numeric zeroes when\n  no add-on-attributed request-history events are available, while detailed\n  charts and tables remain empty.\n- Fixes Dashboard Studio grid validation errors on the TA API health tab by\n  aligning the organization input with the panel grid below it.\n- Fixes the rate-limit summary so it uses the correct aggregated field.\n- Prevents API requests made by unrelated clients from affecting the add-on's\n  API health measurements.\n- Removes redundant broad `sourcetype=\"meraki:*\"` constraints from dashboard\n  searches that already use the `meraki_index` macro. Exact sourcetype filters,\n  including `meraki:apirequestshistory` for TA API health, remain in place.\n- Adds Home dashboard guidance and a direct macro-editor link so administrators\n  can scope `meraki_index` to production indexes without dropping its Meraki\n  sourcetype constraint.\n\n## Upgrade notes\n\n- Existing input configuration and checkpoints remain compatible.\n- Customers running version 3.3.10 should upgrade to version 3.4.0. This release\n  includes the bounded pagination and streaming changes introduced in version\n  3.3.11 to prevent scripted-input out-of-memory failures.\n- Uses `package/VERSION` as the only release-version source. The build stamps\n  `app.conf`, `app.manifest`, the UCC UI configuration, and the numeric Splunk\n  build identifier in generated artifacts without modifying tracked metadata.\n  Repeated builds of the same version advance the prior successful artifact's\n  build number, such as 3400, 3401, and 3402 for version 3.4.0.\n- Adds a release-check command that builds the package, runs unit and lint\n  gates, blocks AppInspect errors and failures, and can create a disposable\n  Splunk Docker lab for modular-input smoke testing under Python 3.13.\n\n## Validation\n\n- The Python 3.13 release gate reports 96 passing tests. Lint, syntax, package\n  metadata, and archive-safety checks also pass.\n- Build-only runs produce `Splunk_TA_cisco_meraki-3.4.0.tgz` with version 3.4.0\n  and a successively increasing build number without installing the add-on.\n- Splunk AppInspect 4.3.0 reports 134 successful checks, nine warnings, and no\n  errors or failures with Splunk Cloud precertification scope.\n- The release workflow performs build and verification without restarting\n  Splunk software.", "passed_validation": true, "path": "https://splunkbase.splunk.com/app/5580/release/3.4.0/download/", "platform": "independent", "product_compatibility": "splunk", "product_types": ["enterprise", "cloud"], "published_time": "2026-08-14T23:14:35.176989Z", "release_id": 123591, "release_name": "3.4.0", "sha256": "d6508c4cb20515aea70616e4e79ed0ad91eb48c87c783d81d65272757f6c978a", "size": 28877147, "spl_compatibility": "SPL1", "tags_sourcetypes": {"__no_tag__": ["meraki:wirelessdeviceswirelesscontrollersbydevice", "meraki:wirelessdevicesethernetstatuses", "meraki:webhooklogs:api", "meraki:switchportsoverview", "meraki:summarytopswitchesbyenergyusage", "meraki:summarytopdevicesbyusage", "meraki:summarytopclientsbyusage", "meraki:summarytopappliancesbyutilization", "meraki:summaryswitchpowerhistory", "meraki:sensorreadingshistory", "meraki:portstransceiversreadingshistorybyswitch", "meraki:organizationsnetworks", "meraki:organizations", "meraki:licensessubscriptions", "meraki:licensessubscriptionentitlements", "meraki:licensesoverview", "meraki:licensescotermlicenses", "meraki:devicesuplinkslossandlatency", "meraki:appliancesdwanstatuses", "meraki:appliancesdwanstatistics", "meraki:apirequestsresponsecodes", "meraki:apirequestsoverview", "meraki:airmarshal", "cisco_meraki_log"], "alert": ["meraki:webhook", "meraki:securityappliances", "meraki:assurancealerts", "meraki:accesspoints"], "attack": ["meraki:organizationsecurity"], "authentication": ["meraki:securityappliances",