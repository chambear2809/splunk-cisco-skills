{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chambear2809/splunk-cisco-skills/blob/main/skills/shared/skill_catalog.schema.json",
  "title": "Splunk and Cisco canonical skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_count",
    "alias_count",
    "shared_sections",
    "taxonomy",
    "skills"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "skill_count": {"type": "integer", "minimum": 0},
    "alias_count": {"type": "integer", "minimum": 0},
    "shared_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_skill_mcp_server"],
      "properties": {
        "local_skill_mcp_server": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[^\\r]*\\S)?$"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "capabilities"],
      "properties": {
        "products": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "name": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"},
              "description": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"}
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product", "id", "name"],
            "properties": {
              "product": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "name": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"}
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "target",
          "purpose",
          "command_summary",
          "product",
          "capability",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {"type": "string", "minLength": 1, "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$"},
          "target": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"},
          "purpose": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"},
          "command_summary": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"},
          "product": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "capability": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"type": "string", "enum": ["canonical", "deprecated"]},
          "replaced_by": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "migration": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "deprecated"}},
              "required": ["status"]
            },
            "then": {"required": ["replaced_by", "migration"]}
          },
          {
            "if": {
              "properties": {"status": {"const": "canonical"}},
              "required": ["status"]
            },
            "then": {
              "allOf": [
                {"not": {"required": ["replaced_by"]}},
                {"not": {"required": ["migration"]}}
              ]
            }
          }
        ]
      }
    }
  }
}
