GALILEO_OTLP_TRACES_ENDPOINT=https://api.demo-v2.galileocloud.io/otel/v1/traces
GALILEO_EXPECTED_ORIGIN=https://api.demo-v2.galileocloud.io
GALILEO_API_KEY_FILE=/etc/splunk-otel-collector/secrets/galileo_api_key
GALILEO_PROXY_URL=http://127.0.0.1:18888
GALILEO_TINYPROXY_EVIDENCE_FILE=/etc/splunk-otel-collector/galileo-tinyproxy-evidence.json
GALILEO_DESTINATION_FINGERPRINT=REPLACE_WITH_REVIEWED_64_HEX_SHA256
GALILEO_QUEUE_STORAGE_DIRECTORY=/var/lib/splunk-otel-collector/galileo-queue/REPLACE_WITH_REVIEWED_64_HEX_SHA256
GALILEO_PROJECT_ID=REPLACE_WITH_PROJECT_ID
GALILEO_LOG_STREAM_ID=REPLACE_WITH_LOG_STREAM_ID
