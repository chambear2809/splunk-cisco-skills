    "documentation-and-placeholders": {
      "count": 9,
      "rationale": "Documentation and example templates contain literal option names, credential placeholders, curl authentication syntax, or PEM boundary text but no credential material."
    },
    "legacy-vendored-package-snapshots": {
      "count": 19,
      "rationale": "Removed historical Splunk package snapshots triggered generic patterns in vendored libraries, generated JavaScript, default configuration, and vendor test code. The immutable commit fingerprints are retained so newly added package content is still scanned."
    },
    "literal-guardrail-and-renderer-syntax": {
      "count": 38,
      "rationale": "First-party validators and renderers intentionally recognize or emit secret option names, file-backed credential syntax, curl flags, and PEM boundaries without embedding values."
    },
    "synthetic-security-tests": {
      "count": 22,
      "rationale": "Security tests intentionally use synthetic secret-shaped sentinels to verify rejection, file guardrails, and redaction. This includes the AWS-shaped value in the secret-like metric rejection test."
    }
  },
