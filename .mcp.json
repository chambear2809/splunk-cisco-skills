{
  "mcpServers": {
    "splunk-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["./splunk-mcp-rendered/run-splunk-mcp.js"]
    },
    "splunk-cisco-skills": {
      "type": "stdio",
      "command": "python3",
      "args": ["-I", "./agent/run-splunk-cisco-skills-mcp.py"],
      "env": {
        "SPLUNK_SKILLS_MCP_ENABLE_EXECUTION": "1",
        "SPLUNK_SKILLS_MCP_ALLOW_GENERIC_EXECUTION": "0",
        "SPLUNK_SKILLS_MCP_ALLOW_MUTATION": "0"
      }
    }
  }
}
